.godot/
# Godot user data / shader cache. Every .runtime-<name> directory is a generated
# per-run APPDATA with the same disposable contents; none of it belongs in Git.
.runtime*/
*.log
Godot*.exe
tests/*.png
# Godot's per-asset import-cache sidecars: regenerated from the source asset on
# any import, never worth version-controlling, and the dominant share (272 of
# 277) of this repo's untracked-file noise before this line was added.
*.import
*.uid
# Recursive test-screenshot captures (tests/*.png above only matched direct children).
tests/captures/
# Development-time OSM/asset downloads; only processed outputs are committed.
data_raw/

# Web export output (rebuild with the Web preset, then python web/package.py)
web/build/
web/dist/
.wrangler/
