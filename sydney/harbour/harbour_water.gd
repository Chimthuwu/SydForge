class_name HarbourWater
extends Node3D

## Phase 6A — the harbour water system for the Sydney world.
##
## Owns every visual harbour water surface in the southern-harbour scope:
## the deep-blue animated water (OSM Port Jackson + bays, plus an authored
## Blackwattle Bay), island land patches above the water, the preserved
## non-harbour Stage A ponds, and the flat land collar that frames the
## coastline where the Stage A ground box and the Phase 5 bridge site end.
##
## The physical shoreline barrier is a SEPARATE system built here with the
## Phase 4 mechanism (one StaticBody3D, one ConcavePolygonShape3D, one
## vertical quad per ring edge, backface collision, 2.4 m tall) from the same
## rings that are rendered, so water stays impassable everywhere it is drawn.
##
## When this node enters the tree it supersedes the pieces it replaces:
##   * the Stage A "Water" mesh is hidden (same plane -> would z-fight),
##   * the Stage A "WaterCollision" body is freed (hiding does not disable
##     physics; the harbour barrier replaces it at the real shoreline),
##   * the bridge's "HarbourExtension" water mesh is hidden (same plane).
## The bridge's own site collision and land are untouched. If this module's
## data is missing, none of that happens and the old water remains.
##
## Generated by tests/harbour_water_prepare.py from the Sydney pipeline
## (read-only); see docs/SYDNEY_HARBOUR_WATER_PHASE6A.md.

const DATA_PATH := "res://sydney/harbour/harbour_water.json"
const SHADER_PATH := "res://sydney/harbour/harbour_water.gdshader"

## Matches SydneyWorld.WATER_WALL_HEIGHT: the player's jump apex is ~1.33 m,
## so a 2.4 m wall can never be cleared.
const WALL_HEIGHT := 2.4
## Same edge rejection as the Phase 4 barrier (edges under 5 cm are dropped).
const MIN_WALL_EDGE := 0.05
## Legacy Stage A water look, kept for the preserved ponds.
const POND_COLOR := Color("2b6f86")
## Matches the Stage A ground box and the bridge site land.
const GROUND_COLOR := Color("5d6258")
## Vertex brightness variation amplitude (subtle patchiness, no texture).
const VARIATION := 0.045
const DEGENERATE_EPSILON := 1e-6

## The rendered water rings, exposed for tests and the physics suite.
var rings: Array[PackedVector2Array] = []
var collision_rings: Array[PackedVector2Array] = []
var stats: Dictionary = {}
var build_error := ""


func build() -> bool:
	var started := Time.get_ticks_usec()
	build_error = ""
	var loaded := _load_data()
	if not loaded:
		return false
	var water_rings: Array = _data.get("waterRings", [])
	var island_rings: Array = _data.get("islandRings", [])
	var pond_rings: Array = _data.get("pondRings", [])
	var land_rings: Array = _data.get("landRings", [])
	var water_y := float(_data.get("waterY", 0.02))
	var island_y := float(_data.get("islandY", 0.1))

	rings.clear()
	for ring in water_rings:
		var packed := _packed_ring(ring)
		if packed.size() >= 3 and absf(_signed_area(packed)) > 0.5:
			rings.append(packed)
	if rings.is_empty():
		return _fail("no usable water rings in " + DATA_PATH)

	collision_rings = rings.duplicate()
	for ring in island_rings:
		var packed := _packed_ring(ring)
		if packed.size() >= 3:
			collision_rings.append(packed)
	for ring in pond_rings:
		var packed := _packed_ring(ring)
		if packed.size() >= 3:
			collision_rings.append(packed)

	var surface := _water_surface(rings, water_y)
	if surface == null:
		return _fail("water surface mesh could not be built")
	var surface_node := MeshInstance3D.new()
	surface_node.name = "HarbourWaterSurface"
	surface_node.mesh = surface
	add_child(surface_node)

	if not island_rings.is_empty():
		_add_flat_mesh("HarbourIslands", island_rings, island_y, GROUND_COLOR)
	if not pond_rings.is_empty():
		_add_flat_mesh("HarbourPonds", pond_rings, water_y, POND_COLOR)
	var land_collision_triangles := 0
	if not land_rings.is_empty():
		_add_flat_mesh("HarbourLand", land_rings, 0.0, GROUND_COLOR)
		var floor_faces := _flat_faces(land_rings, 0.0)
		if floor_faces.size() >= 3:
			var land_body := StaticBody3D.new()
			land_body.name = "HarbourLandCollision"
			add_child(land_body)
			var land_collider := CollisionShape3D.new()
			var land_shape := ConcavePolygonShape3D.new()
			land_shape.backface_collision = true
			land_shape.set_faces(floor_faces)
			land_collider.shape = land_shape
			land_body.add_child(land_collider)
			land_collision_triangles = floor_faces.size() / 3

	var edges := _build_collision()
	stats = {
		"waterRings": rings.size(),
		"waterVertices": _vertex_count(rings),
		"waterTriangles": _mesh_triangles(surface),
		"waterAreaM2": roundf(_total_area(rings)),
		"islandRings": island_rings.size(),
		"pondRings": pond_rings.size(),
		"landRings": land_rings.size(),
		"landCollisionTriangles": land_collision_triangles,
		"collisionRings": collision_rings.size(),
		"collisionEdges": edges,
		"collisionTriangles": edges * 2,
		"wallHeightM": WALL_HEIGHT,
		"buildMs": (Time.get_ticks_usec() - started) / 1000.0,
	}
	return true


func _ready() -> void:
	# Supersede the surfaces this module replaces. Guarded so a missing node
	# (older world layout, tests with a stripped tree) is never an error.
	var parent := get_parent()
	if parent == null:
		return
	var old_water := parent.get_node_or_null("Water")
	if old_water != null:
		old_water.visible = false
	var old_collision := parent.get_node_or_null("WaterCollision")
	if old_collision != null:
		old_collision.queue_free()
	var bridge_water := parent.get_node_or_null("HarbourBridge/HarbourExtension")
	if bridge_water != null:
		bridge_water.visible = false


var _data: Dictionary = {}


func _fail(message: String) -> bool:
	build_error = message
	push_error("HarbourWater: " + message)
	return false


func _load_data() -> bool:
	if not FileAccess.file_exists(DATA_PATH):
		return _fail("data file not found: " + DATA_PATH)
	var file := FileAccess.open(DATA_PATH, FileAccess.READ)
	if file == null:
		return _fail("cannot open " + DATA_PATH)
	var text := file.get_as_text()
	file.close()
	var json := JSON.new()
	if json.parse(text) != OK:
		return _fail("JSON parse error at line %d" % json.get_error_line())
	var parsed = json.data
	if typeof(parsed) != TYPE_DICTIONARY:
		return _fail("root JSON value is not an object")
	if String(parsed.get("format", "")) != "splooge-harbour-water":
		return _fail("unexpected format: " + String(parsed.get("format", "")))
	if int(parsed.get("formatVersion", 0)) != 1:
		return _fail("unsupported formatVersion")
	_data = parsed
	return true


func _packed_ring(raw: Array) -> PackedVector2Array:
	var points := PackedVector2Array()
	for item in raw:
		if typeof(item) != TYPE_ARRAY or item.size() < 2:
			continue
		var x := float(item[0])
		var z := float(item[1])
		if is_nan(x) or is_inf(x) or is_nan(z) or is_inf(z):
			continue
		var point := Vector2(x, z)
		if points.is_empty() or points[-1].distance_to(point) > 0.001:
			points.append(point)
	return points


func _signed_area(points: PackedVector2Array) -> float:
	var total := 0.0
	for index in points.size():
		var a := points[index]
		var b := points[(index + 1) % points.size()]
		total += a.x * b.y - b.x * a.y
	return total * 0.5


func _total_area(ring_list: Array) -> float:
	var total := 0.0
	for points in ring_list:
		total += absf(_signed_area(points))
	return total


func _vertex_count(ring_list: Array) -> int:
	var total := 0
	for points in ring_list:
		total += points.size()
	return total


func _mesh_triangles(mesh: ArrayMesh) -> int:
	var total := 0
	for surface_index in mesh.get_surface_count():
		var arrays := mesh.surface_get_arrays(surface_index)
		var indices = arrays[Mesh.ARRAY_INDEX]
		if indices is PackedInt32Array and indices.size() > 0:
			total += indices.size() / 3
		else:
			total += mesh.surface_get_array_len(surface_index) / 3
	return total


## Deep-blue water surface with per-vertex brightness variation. Emission is
## local (not SydneyMesh) because the shared builders have no vertex-colour
## path; winding is oriented to the up normal like SydneyMesh._add_triangle.
func _water_surface(ring_list: Array, y: float) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	var emitted := 0
	for points in ring_list:
		var ring_points: PackedVector2Array = points
		if ring_points.size() < 3:
			continue
		var indices := Geometry2D.triangulate_polygon(ring_points)
		if indices.is_empty():
			push_warning("HarbourWater: ring with %d points failed to triangulate" % ring_points.size())
			continue
		for index in range(0, indices.size(), 3):
			var a2: Vector2 = ring_points[indices[index]]
			var b2: Vector2 = ring_points[indices[index + 1]]
			var c2: Vector2 = ring_points[indices[index + 2]]
			var a := Vector3(a2.x, y, a2.y)
			var b := Vector3(b2.x, y, b2.y)
			var c := Vector3(c2.x, y, c2.y)
			if (b - a).cross(c - a).length() < DEGENERATE_EPSILON:
				continue
			if (b - a).cross(c - a).y < 0.0:
				var swap := b
				b = c
				c = swap
			_add_shaded_vertex(surface, a)
			_add_shaded_vertex(surface, b)
			_add_shaded_vertex(surface, c)
			emitted += 1
	if emitted == 0:
		return null
	var mesh := surface.commit()
	if mesh != null and mesh.get_surface_count() > 0:
		mesh.surface_set_material(0, _water_material())
	return mesh


func _add_shaded_vertex(surface: SurfaceTool, point: Vector3) -> void:
	surface.set_normal(Vector3.UP)
	surface.set_color(_variation_color(point.x, point.z))
	surface.add_vertex(point)


## Slow incommensurate sine fields: gentle brightness patches (~100 m and
## ~270 m wavelengths) plus a slight green shift. Deterministic.
func _variation_color(x: float, z: float) -> Color:
	var w1 := sin(x * 0.061 + z * 0.043)
	var w2 := sin(x * 0.023 - z * 0.034 + 2.0)
	var brightness := 1.0 + VARIATION * w1 + VARIATION * 0.6 * w2
	var green := 1.0 + 0.02 * w2
	return Color(brightness, brightness * green, brightness)


func _water_material() -> Material:
	var shader := load(SHADER_PATH) as Shader
	if shader == null:
		push_warning("HarbourWater: shader missing; falling back to a flat material")
		var fallback := StandardMaterial3D.new()
		fallback.albedo_color = Color("1e5678")
		fallback.roughness = 0.38
		fallback.cull_mode = BaseMaterial3D.CULL_DISABLED
		fallback.vertex_color_use_as_albedo = true
		return fallback
	var material := ShaderMaterial.new()
	material.shader = shader
	return material


## Islands, ponds and the land collar reuse the shared flat builder, so they
## share the cached materials (and exact look) of the existing world layers.
func _add_flat_mesh(node_name: String, ring_list: Array, y: float, color: Color) -> void:
	var mesh := SydneyMesh.flat_polygons(ring_list, y, color)
	if mesh == null:
		return
	var node := MeshInstance3D.new()
	node.name = node_name
	node.mesh = mesh
	add_child(node)


## Triangulated horizontal faces at `y` for a set of raw JSON rings. Used for
## the land collar's floor collision: the Stage A ground box stops at bounds
## +/- 150 m, so without this the player would fall through the collar land
## west of Darling Harbour and east of the ground box.
func _flat_faces(ring_list: Array, y: float) -> PackedVector3Array:
	var faces := PackedVector3Array()
	for raw in ring_list:
		var points := _packed_ring(raw)
		if points.size() < 3:
			continue
		var indices := Geometry2D.triangulate_polygon(points)
		if indices.is_empty():
			continue
		for index in range(0, indices.size(), 3):
			var a := points[indices[index]]
			var b := points[indices[index + 1]]
			var c := points[indices[index + 2]]
			if absf((b - a).cross(c - a)) < DEGENERATE_EPSILON:
				continue
			faces.append(Vector3(a.x, y, a.y))
			faces.append(Vector3(b.x, y, b.y))
			faces.append(Vector3(c.x, y, c.y))
	return faces


## Phase 4 barrier mechanism, applied to the harbour rings: one vertical quad
## (two triangles) per ring edge from the water surface to 2.4 m, all in one
## StaticBody3D with a single backface-colliding concave shape.
func _build_collision() -> int:
	var faces := PackedVector3Array()
	var edges := 0
	for ring in collision_rings:
		if ring.size() < 3:
			continue
		for index in ring.size():
			var a := ring[index]
			var b := ring[(index + 1) % ring.size()]
			if a.distance_squared_to(b) < MIN_WALL_EDGE * MIN_WALL_EDGE:
				continue
			var bottom_a := Vector3(a.x, 0.0, a.y)
			var bottom_b := Vector3(b.x, 0.0, b.y)
			var top_a := Vector3(a.x, WALL_HEIGHT, a.y)
			var top_b := Vector3(b.x, WALL_HEIGHT, b.y)
			faces.append(bottom_a)
			faces.append(bottom_b)
			faces.append(top_b)
			faces.append(bottom_a)
			faces.append(top_b)
			faces.append(top_a)
			edges += 1
	if faces.is_empty():
		push_warning("HarbourWater: no collision edges; the harbour has no barrier")
		return 0
	var body := StaticBody3D.new()
	body.name = "HarbourWaterCollision"
	# The shoreline is a hard barrier: the player may not wall-climb over it.
	body.add_to_group("no_climb")
	add_child(body)
	var collider := CollisionShape3D.new()
	var shape := ConcavePolygonShape3D.new()
	shape.backface_collision = true
	shape.set_faces(faces)
	collider.shape = shape
	body.add_child(collider)
	return edges


## True when a world-space XZ point lies inside any rendered water ring.
func is_water(x: float, z: float) -> bool:
	var point := Vector2(x, z)
	for ring in rings:
		if Geometry2D.is_point_in_polygon(point, ring):
			return true
	return false
